<!DOCTYPE html>
<html>
<head>
    <script type="application/jay-headless"
            src="./header/header"
            contract="./header/header.jay-contract"></script>
    <script type="application/jay-data" contract="./page.jay-contract">
    </script>
</head>
<body>
    <div>
        <h1>{title}</h1>
        <div class="card">
            <jay:header itemId="1">
                <div class="widget">
                    <span class="label">{label}</span>
                    <span class="value">{value}</span>
                    <button ref="increment">+1</button>
                </div>
            </jay:header>
        </div>
        <div class="card">
            <jay:header itemId="3">
                <div class="widget">
                    <span class="label">{label}</span>
                    <span class="value">{value}</span>
                    <button ref="increment">+1</button>
                </div>
            </jay:header>
        </div>
    </div>
</body>
</html>

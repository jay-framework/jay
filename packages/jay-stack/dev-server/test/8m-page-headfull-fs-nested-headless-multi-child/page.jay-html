<!DOCTYPE html>
<html>
<head>
    <script type="application/jay-headless"
            src="./header/header"
            contract="./header/header.jay-contract"></script>
    <script type="application/jay-headless"
            plugin="test-widget"
            contract="widget"></script>
    <script type="application/jay-data" contract="./page.jay-contract">
    </script>
</head>
<body>
    <div>
        <h1>{pageTitle}</h1>
        <jay:header logoUrl="/logo.png">
            <div class="top-bar">
                <img src="{logoUrl}" style="width: 36px; height: 36px" />
            </div>
            <div class="content">
                <jay:widget itemId="1">
                    <div class="widget">
                        <span class="label">{label}</span>
                        <div class="basic" if="!showBadge">
                            <span class="value">{value}</span>
                        </div>
                        <div class="full" if="showBadge">
                            <span class="value">{value}</span>
                            <button ref="increment">+1</button>
                        </div>
                    </div>
                </jay:widget>
            </div>
        </jay:header>
    </div>
</body>
</html>

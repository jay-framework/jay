name: Page
tags:
  - tag: pageTitle
    type: data
    dataType: string
    phase: slow
  - tag: reqStatus
    type: variant
    dataType: enum (success | warning | error)
    phase: fast
  - tag: reqCount
    type: data
    dataType: number
    phase: fast
  - tag: reqActive
    type: variant
    dataType: boolean
    phase: fast

<!DOCTYPE html>
<html>
<head>
    <title>Keyed Headless With Page Contract</title>
    <script type="application/jay-headless"
            plugin="test-headless"
            contract="headless"
            key="headless"></script>
    <script type="application/jay-data" contract="./page.jay-contract">
    </script>
</head>
<body>
    <div>
        <p class="message">{headless.message}</p>
        <span class="active" if="headless.isActive">on</span>
        <input class="field" aria-invalid="{headless.invalid}" />
        <button ref="headless.toggle">toggle</button>
        <button class="page-button" ref="pageButton">page</button>
    </div>
</body>
</html>

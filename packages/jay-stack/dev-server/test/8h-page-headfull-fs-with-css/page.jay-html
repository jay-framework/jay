<!DOCTYPE html>
<html>
<head>
    <script type="application/jay-headless"
            src="./header/header"
            contract="./header/header.jay-contract"></script>
    <script type="application/jay-data" contract="./page.jay-contract">
    </script>
    <style>
        .widget { border: 1px solid #ccc; padding: 8px; }
        .widget .label { font-weight: bold; }
    </style>
</head>
<body>
    <div>
        <h1>{pageTitle}</h1>
        <jay:header itemId="1">
            <div class="widget">
                <span class="label">{label}</span>
                <span class="value">{value}</span>
                <button ref="increment">+1</button>
            </div>
        </jay:header>
    </div>
</body>
</html>

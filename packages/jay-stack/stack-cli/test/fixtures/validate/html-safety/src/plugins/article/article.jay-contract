name: article
tags:
  - tag: title
    type: data
    dataType: string
  - tag: body
    type: data
    dataType: html-string
  - tag: sections
    type: sub-contract
    repeated: true
    trackBy: id
    tags:
      - tag: id
        type: data
        dataType: string
      - tag: body
        type: data
        dataType: html-string
  - tag: author
    type: sub-contract
    link: ./author

{
    "version": "0.2.0",
    "projectRoot": ".",
    "sharedManifest": {},
    "routes": [
        {
            "pattern": "/",
            "segments": [],
            "serverModule": "home.server.js"
        },
        {
            "pattern": "/about",
            "segments": [
                {
                    "type": "static",
                    "value": "about"
                }
            ],
            "serverModule": "about.server.js"
        },
        {
            "pattern": "/blog/[slug]",
            "segments": [
                {
                    "type": "static",
                    "value": "blog"
                },
                {
                    "type": "param",
                    "value": "slug"
                }
            ],
            "serverModule": "blog.server.js",
            "headMeta": {
                "title": [
                    {
                        "kind": "binding",
                        "value": "post.title"
                    }
                ],
                "meta": [
                    {
                        "name": "description",
                        "content": [
                            {
                                "kind": "static",
                                "value": "A blog post"
                            }
                        ]
                    }
                ],
                "links": []
            }
        }
    ],
    "actions": [],
    "plugins": []
}

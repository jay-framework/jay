<html>
<head>
    <script type="application/jay-data">
data:
    title: string
    </script>
    <script type="application/jay-headless"
            contract="./components/card/card.jay-contract"
            template="./components/card/card.jay-html"></script>
    <style>
@scope (.promo) {
    .card-heading { color: red; font-weight: bold; }
    .card-body { margin: 0; }
}
    </style>
</head>
<body>
<div>
    <h1>{title}</h1>

    <!-- Region carries ref="promo"; its @scope block edits .card-heading color with no override pragma. -->
    <jay:card ref="promo" heading="{title}">
        <div class="card promo">
            <h3 class="card-heading">{heading}</h3>
            <p class="card-body">Default body</p>
        </div>
    </jay:card>
</div>
</body>
</html>

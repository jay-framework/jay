{
  "name": "@jay-framework/share",
  "version": "0.26.5",
  "type": "module",
  "description": "Share Jay local plugins through a dedicated git repo — link, pull, push, publish, restore (DL#237)",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "plugin.yaml"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tools": "./dist/tools.js",
    "./plugin.yaml": "./plugin.yaml"
  },
  "scripts": {
    "build": "npm run clean && npm run build:server && npm run build:types && npm run validate",
    "validate": "jay-stack-cli validate-plugin",
    "build:server": "vite build --ssr",
    "build:types": "tsup lib/index.ts lib/tools.ts --dts-only --format esm",
    "build:check-types": "tsc",
    "clean": "rimraf dist",
    "confirm": "npm run clean && npm run build && npm run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@jay-framework/dev-server": "workspace:^",
    "@jay-framework/fullstack-component": "workspace:^",
    "@jay-framework/plugin-validator": "workspace:^",
    "@jay-framework/stack-server-build": "workspace:^",
    "@jay-framework/stack-server-runtime": "workspace:^",
    "yaml": "^2.3.4"
  },
  "peerDependencies": {
    "@jay-framework/compiler-shared": "workspace:^"
  },
  "devDependencies": {
    "@jay-framework/compiler-jay-html": "workspace:^",
    "@jay-framework/compiler-shared": "workspace:^",
    "@jay-framework/dev-environment": "workspace:^",
    "@jay-framework/jay-stack-cli": "workspace:^",
    "@types/node": "^22.15.21",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.2.1"
  }
}

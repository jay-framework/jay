{
  "name": "@jay-framework/editing-policy",
  "version": "0.26.0",
  "type": "module",
  "description": "Editing-policy plugin for Jay Framework (DL#231) — policy file format, policy-file validation, and baseline-vs-candidate change comparison",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "bin": "dist/compare.js",
  "files": [
    "dist",
    "plugin.yaml",
    "agent-kit"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tools": "./dist/tools.js",
    "./api": "./dist/api.js",
    "./plugin.yaml": "./plugin.yaml"
  },
  "scripts": {
    "build": "npm run clean && npm run build:server && npm run build:types && npm run validate",
    "validate": "jay-stack-cli validate-plugin",
    "build:server": "vite build --ssr",
    "build:types": "tsup lib/index.ts lib/tools.ts lib/api.ts lib/bin/compare.ts --dts-only --format esm",
    "build:check-types": "tsc",
    "clean": "rimraf dist",
    "confirm": "npm run clean && npm run build && npm run test",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@jay-framework/compiler-shared": "workspace:^"
  },
  "dependencies": {
    "@jay-framework/compiler-inline-composition": "workspace:^",
    "@jay-framework/compiler-jay-html": "workspace:^",
    "@jay-framework/design-system-validator": "workspace:^",
    "minimatch": "^9.0.3",
    "node-html-parser": "^6.1.12",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@jay-framework/compiler-shared": "workspace:^",
    "@jay-framework/dev-environment": "workspace:^",
    "@jay-framework/jay-stack-cli": "workspace:^",
    "@types/node": "^22.15.21",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}

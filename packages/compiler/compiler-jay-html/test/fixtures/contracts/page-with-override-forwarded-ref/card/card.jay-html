<html>
<head>
    <script type="application/jay-data" contract="./card.jay-contract"></script>
</head>
<body>
<!--
  Generic (Tier 2) structural card: jay-html + jay-contract, no .ts. It knows nothing about Counter.
  `<div ref="slot">` is an override-only anchor (DL#181) — a ref present in the jay-html but NOT in the
  contract — so the page can inject content into it via `<override ref="slot">…</override>`.
-->
<div class="card">
    <h3>{heading}</h3>
    <div class="slot" ref="slot"></div>
</div>
</body>
</html>

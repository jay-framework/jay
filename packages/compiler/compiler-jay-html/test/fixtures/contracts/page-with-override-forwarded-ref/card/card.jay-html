<html>
<head>
    <script type="application/jay-data" contract="./card.jay-contract"></script>
</head>
<body>
<!--
  Generic (Tier 2) structural card: jay-html + jay-contract, no .ts. It knows nothing about Counter.
  `<div ref="slot">` is the template anchor for the contract's `slot` (a `type: slot` tag, DL#194) —
  so the page can inject content into it via `<override slot="slot">…</override>`.
-->
<div class="card">
    <h3>{heading}</h3>
    <div class="slot" ref="slot"></div>
</div>
</body>
</html>

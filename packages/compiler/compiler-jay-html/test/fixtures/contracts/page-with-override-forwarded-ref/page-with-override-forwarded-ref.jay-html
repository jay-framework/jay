<html>
<head>
    <script type="application/jay-headfull"
            src="./card/card"
            contract="./card/card.jay-contract"
            names="card"></script>
    <!-- The PAGE imports Counter — the generic card has no idea Counter exists. The page decides
         what to inject into the card's `slot` via <override>. -->
    <script type="application/jay-headfull"
            src="../../components/counter/counter"
            names="Counter"></script>
    <script type="application/jay-data">
data:
    pageTitle: string
    cards:
        - id: string
          label: string
    </script>
</head>
<body>
<div>
    <h1>{pageTitle}</h1>

    <!-- Single injected composite — its `cta` forwards to refs.signupCard.cta. Per DL#193 §C the
         injected ref carries the OUTER (page) scope, not the card's own ViewState. -->
    <jay:card heading="Sign up" ref="signupCard">
        <override slot="slot">
            <jay:Counter ref="cta" initialValue="0" />
        </override>
    </jay:card>

    <!-- Repeated injected composite — the outer scope is the forEach item, so the forwarded
         collection ref re-bases to the item scope for onChange and find/map. -->
    <ul forEach="cards" trackBy="id">
        <li>
            <jay:card heading="{label}" ref="cards">
                <override slot="slot">
                    <jay:Counter ref="cta" initialValue="0" />
                </override>
            </jay:card>
        </li>
    </ul>
</div>
</body>
</html>

<html>
<head>
    <script type="application/jay-headfull"
            src="./card/card"
            contract="./card/card.jay-contract"
            names="card"></script>
    <script type="application/jay-data">
data:
    pageTitle: string
    </script>
</head>
<body>
<div>
    <h1>{pageTitle}</h1>
    <jay:card ref="plainCard" heading="Plain"></jay:card>
    <jay:card ref="richCard" heading="Rich">
        <override slot="body">
            <button ref="cta">{pageTitle}</button>
        </override>
    </jay:card>
</div>
</body>
</html>

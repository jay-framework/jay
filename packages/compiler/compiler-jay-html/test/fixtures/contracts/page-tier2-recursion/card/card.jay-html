<html>
<head>
    <script type="application/jay-headfull"
            src="./card"
            contract="./card.jay-contract"
            names="card"></script>
    <script type="application/jay-data" contract="./card.jay-contract"></script>
</head>
<body>
<div class="card">
    <h3>{heading}</h3>
    <jay:card heading="Nested" />
</div>
</body>
</html>

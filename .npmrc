# NPM Configuration for automated publishing
# No registry here: it would override the user's registry for every npm/npx call in the repo.
# The publish registry is npmPublishRegistry in .yarnrc.yml (scripts/publish.cjs publishes with yarn).
access=public

# Automatically use OTP from environment variable
otp=${NPM_OTP}

# Skip confirmation prompts
yes=true

# Use legacy peer deps to avoid warnings
legacy-peer-deps=true 
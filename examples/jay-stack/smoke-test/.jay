devServer:
  portRange: [3300, 3310]
  pagesBase: './src/pages'
  publicFolder: './public'
  # DL#219 — inject source-editing markers so /what-is-this.html can inspect pages.
  sourceEditing: true
site:
  baseUrl: https://smoke-test.example.com
server:
  # DL#239 — break actions that run past this budget into a 202 + ticket poll (and streams into
  # resumable segments). Small here so the long.* actions exercise the path; counter.* stay under it.
  actionPollAfterMs: 400

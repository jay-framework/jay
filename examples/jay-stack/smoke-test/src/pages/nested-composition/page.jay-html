<html>
<head>
  <script type="application/jay-headless"
          src="../../components/section/section"
          contract="../../components/section/section.jay-contract"></script>
  <script type="application/jay-headless"
          contract="../../components/card/card.jay-contract"></script>
  <script type="application/jay-headless"
          src="../../components/button/button"
          contract="../../components/button/button.jay-contract"></script>
  <script type="application/jay-data" contract="./page.jay-contract"></script>
</head>
<body>
  <div>
    <h1>{pageTitle}</h1>
    <!-- Realistic nested composition flattened into the page (DL#196): a coded button inside a
         passthrough card inside a coded section. The section's title threads down as the card
         heading and then the button label, proving data flows through nested flattened regions. -->
    <jay:section ref="section" title="Featured">
      <section class="section">
        <h2>Section: {title}</h2>
        <jay:card heading="{title}">
          <div class="card">
            <h3>Card: {heading}</h3>
            <jay:button label="{heading}">
              <button ref="clickAction" class="btn">Button: {label}</button>
            </jay:button>
          </div>
        </jay:card>
      </section>
    </jay:section>
  </div>
</body>
</html>

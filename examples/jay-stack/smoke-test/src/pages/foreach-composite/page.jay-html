<html>
<head>
  <script type="application/jay-headfull"
          src="../../components/rich-card/rich-card"
          contract="../../components/rich-card/rich-card.jay-contract"
          names="richCard"></script>
  <script type="application/jay-headfull"
          src="../../components/promo-card/promo-card"
          contract="../../components/promo-card/promo-card.jay-contract"
          names="promoCard"></script>
  <script type="application/jay-data" contract="./page.jay-contract"></script>
</head>
<body>
  <div>
    <h1>{pageTitle}</h1>
    <!-- Both a Tier 3 (coded) and a Tier 2 (inlined) component are repeated by the parent forEach.
         Each override binds to the item scope ({title}) — the critical scoping check is that every
         repeated instance resolves its OWN item, exercising repeated coordinates + per-item view
         state together across both tiers. ($parent from inside an override is not yet supported on
         the SSR/server target — see DL#194.) -->
    <div class="cards" forEach="cards" trackBy="id">
      <jay:richCard ref="richCards" heading="{title}">
        <override slot="body">
          <button ref="cta">Body for {title}</button>
        </override>
      </jay:richCard>
      <jay:promoCard ref="promoCards" heading="{title}">
        <override slot="cta">CTA for {title}</override>
      </jay:promoCard>
    </div>
  </div>
</body>
</html>

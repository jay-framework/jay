<html>
<head>
  <script type="application/jay-headfull"
          src="../../components/rich-card/rich-card"
          contract="../../components/rich-card/rich-card.jay-contract"
          names="richCard"></script>
  <script type="application/jay-headfull"
          src="../../components/promo-card/promo-card"
          contract="../../components/promo-card/promo-card.jay-contract"
          names="promoCard"></script>
  <script type="application/jay-headfull"
          src="../../components/override-card/override-card"
          contract="../../components/override-card/override-card.jay-contract"
          names="overrideCard"></script>
  <script type="application/jay-data" contract="./page.jay-contract"></script>
</head>
<body>
  <div>
    <h1>{pageTitle}</h1>

    <!-- Tier 3 (coded) component — Fork C: the `body` slot is parent-owned (foreignChild) and its
         nested ref surfaces at refs.richCard.body.cta; the override resolves the page-scope binding. -->
    <jay:richCard ref="richCard" heading="Rich Heading">
      <override slot="body">
        <button ref="cta">Body for {pageTitle}</button>
      </override>
    </jay:richCard>

    <!-- Tier 2 (inlined) component — a slot override that resolves a page-scope binding ({pageTitle}),
         alongside the instance's own prop (heading). -->
    <jay:promoCard ref="promoCard" heading="Premium">
      <override slot="cta">Start {pageTitle} trial</override>
    </jay:promoCard>

    <!-- Tier 2 (inlined) component — the full override vocabulary: content replace, attribute + style
         merge on an element ref, slot removal (empty override), and container content replace. -->
    <jay:overrideCard ref="overrideCard">
      <override slot="cta">Start free trial</override>
      <override ref="hero" src="/images/new-hero.png" alt="New hero" />
      <override ref="hero" style="border-radius: 16px; box-shadow: none" />
      <override slot="disclaimer"></override>
      <override slot="menu">
        <a href="/home">Home</a>
        <a href="/docs">Docs</a>
      </override>
    </jay:overrideCard>
  </div>
</body>
</html>

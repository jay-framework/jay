<html>
<head>
  <script type="application/jay-headfull"
          src="../../components/promo-card/promo-card"
          contract="../../components/promo-card/promo-card.jay-contract"
          names="promoCard"></script>
  <script type="application/jay-data" contract="./page.jay-contract"></script>
</head>
<body>

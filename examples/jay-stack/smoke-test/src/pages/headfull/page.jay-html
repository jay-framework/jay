<html>
<head>
  <script type="application/jay-headless"
          src="../../components/banner/banner"
          contract="../../components/banner/banner.jay-contract"></script>
  <script type="application/jay-headless"
          contract="../../components/info-box/info-box.jay-contract"></script>
  <script type="application/jay-headless"
          contract="../../components/badge/badge.jay-contract"></script>
  <script type="application/jay-data" contract="./page.jay-contract"></script>
  <style>
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 2px 10px;
      border: 1px solid #ccc;
      border-radius: 12px;
      font: 13px/1.4 sans-serif;
    }
    .badge--success { border-color: #2d7d2d; color: #2d7d2d; }
    .badge--warning { border-color: #b8860b; color: #b8860b; }
    .badge--error   { border-color: #c0392b; color: #c0392b; }
    .badge-icon { font-weight: bold; }
    .badge-label { font-weight: 600; }
    .badge-count { color: #666; }
    .badge-star { color: #d4af37; }
  </style>
</head>
<body>
  <div>
    <h1>{pageTitle}</h1>
    <jay:banner text="Hello from banner">
      <div class="banner">
        <strong class="banner-text">{bannerText}</strong>
      </div>
    </jay:banner>
    <jay:info-box>
      <div class="info-box">
        <strong>Structural Component Works</strong>
      </div>
    </jay:info-box>
    <jay:badge label="Live Status" status="success" count="42" featured="true">
      <span class="badge {status === success ? badge--success} {status === warning ? badge--warning} {status === error ? badge--error}">
        <span if="status == success" class="badge-icon badge-icon--success">[OK]</span>
        <span if="status == warning" class="badge-icon badge-icon--warning">[!]</span>
        <span if="status == error" class="badge-icon badge-icon--error">[X]</span>
        <span class="badge-label">{label}</span>
        <span class="badge-count">Count: {count}</span>
        <span if="featured" class="badge-star">FEATURED</span>
      </span>
    </jay:badge>
    <jay:badge label="Dynamic Status" status="{currentStatus}" count="{liveCount}" featured="false">
      <span class="badge {status === success ? badge--success} {status === warning ? badge--warning} {status === error ? badge--error}">
        <span if="status == success" class="badge-icon badge-icon--success">[OK]</span>
        <span if="status == warning" class="badge-icon badge-icon--warning">[!]</span>
        <span if="status == error" class="badge-icon badge-icon--error">[X]</span>
        <span class="badge-label">{label}</span>
        <span class="badge-count">Count: {count}</span>
        <span if="featured" class="badge-star">FEATURED</span>
      </span>
    </jay:badge>
    <button ref="cycleButton">Cycle status</button>
  </div>
</body>
</html>

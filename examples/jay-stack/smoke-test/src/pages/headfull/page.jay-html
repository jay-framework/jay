<html>
<head>
  <script type="application/jay-headfull"
          src="../../components/banner/banner"
          contract="../../components/banner/banner.jay-contract"
          names="banner"></script>
  <script type="application/jay-headfull"
          src="../../components/info-box/info-box"
          contract="../../components/info-box/info-box.jay-contract"
          names="infoBox"></script>
  <script type="application/jay-headfull"
          src="../../components/badge/badge"
          contract="../../components/badge/badge.jay-contract"
          names="badge"></script>
  <script type="application/jay-data" contract="./page.jay-contract"></script>
</head>
<body>
  <div>
    <h1>{pageTitle}</h1>
    <jay:banner text="Hello from banner" />
    <jay:infoBox></jay:infoBox>
    <jay:badge label="Live Status" status="success" count="42" featured="true" />
    <jay:badge label="Dynamic Status" status="{currentStatus}" count="{liveCount}" featured="false" />
    <button ref="cycleButton">Cycle status</button>
  </div>
</body>
</html>

<html>
<head>
  <script type="application/jay-headless" plugin="jay-stack" contract="error" key="error"></script>
  <script type="application/jay-data">
    data:
  </script>
  <title>{error.title}</title>
</head>
<body>
  <main class="error-page error-page--504">
    <h1>{error.status} — {error.title}</h1>
    <p class="gateway-timeout-note">This is the dedicated 504 Gateway Timeout page.</p>
    <p>{error.message}</p>
    <ul forEach="error.details" trackBy="key">
      <li>{key}: {value}</li>
    </ul>
    <a href="/">Go home</a>
  </main>
</body>
</html>

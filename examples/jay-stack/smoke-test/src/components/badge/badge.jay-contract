name: Badge
props:
  - name: label
    type: string
    required: true
  - name: status
    type: enum (success | warning | error)
    required: true
  - name: count
    type: number
    required: true
  - name: featured
    type: boolean
    required: true
tags:
  - tag: label
    type: data
    dataType: string
    phase: slow
  - tag: status
    type: variant
    dataType: enum (success | warning | error)
    phase: fast+interactive
  - tag: count
    type: data
    dataType: number
    phase: fast
  - tag: featured
    type: variant
    dataType: boolean
    phase: fast

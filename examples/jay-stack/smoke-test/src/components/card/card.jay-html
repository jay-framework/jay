<html>
<head>
  <!-- Card is a no-code component (no .ts) — a passthrough backs it and its source template is
       flattened into the consumer (DL#196). It composes the coded button, declared with
       application/jay-headless (src + contract); the flattened button body below is card's own
       materialised region. -->
  <script type="application/jay-headless"
          src="../button/button"
          contract="../button/button.jay-contract"></script>
  <script type="application/jay-data" contract="./card.jay-contract"></script>
</head>
<body>
  <div class="card">
    <h3>Card: {heading}</h3>
    <jay:button label="{heading}">
      <button ref="clickAction" class="btn">Button: {label}</button>
    </jay:button>
  </div>
</body>
</html>

<html>
<head>
  <!-- Card is Tier 2 (no .ts) — it is inlined into its consumer. It internally composes the
       Tier 3 <jay:button>, so an inlined component that itself contains a real component boundary
       is exercised (button in card). -->
  <script type="application/jay-headfull"
          src="../button/button"
          contract="../button/button.jay-contract"
          names="button"></script>
  <script type="application/jay-data" contract="./card.jay-contract"></script>
</head>
<body>
  <div class="card">
    <h3>Card: {heading}</h3>
    <jay:button ref="action" label="{heading}" />
  </div>
</body>
</html>

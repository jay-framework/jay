<html>
<head>
  <!-- Section is Tier 3 (has .ts) — a real component boundary. It internally composes the Tier 2
       <jay:card>, which in turn composes the Tier 3 <jay:button>. This gives an alternating
       Tier 3 > Tier 2 > Tier 3 nest (section > card > button). -->
  <script type="application/jay-headfull"
          src="../card/card"
          contract="../card/card.jay-contract"
          names="card"></script>
  <script type="application/jay-data" contract="./section.jay-contract"></script>
</head>
<body>
  <section class="section">
    <h2>Section: {title}</h2>
    <jay:card ref="card" heading="{title}" />
  </section>
</body>
</html>

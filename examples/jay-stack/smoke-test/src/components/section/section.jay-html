<html>
<head>
  <!-- Section is a coded component (has .ts). It composes the no-code card, which in turn composes
       the coded button. Under DL#196 every composed component is declared with
       application/jay-headless and its source template is flattened in transitively: the no-code
       card carries only a contract (a passthrough backs it), while the coded button also carries a
       src. The flattened card > button body below is section's own materialised region. -->
  <script type="application/jay-headless" contract="../card/card.jay-contract"></script>
  <script type="application/jay-headless"
          src="../button/button"
          contract="../button/button.jay-contract"></script>
  <script type="application/jay-data" contract="./section.jay-contract"></script>
</head>
<body>
  <section class="section">
    <h2>Section: {title}</h2>
    <jay:card heading="{title}">
      <div class="card">
        <h3>Card: {heading}</h3>
        <jay:button label="{heading}">
          <button ref="clickAction" class="btn">Button: {label}</button>
        </jay:button>
      </div>
    </jay:card>
  </section>
</body>
</html>

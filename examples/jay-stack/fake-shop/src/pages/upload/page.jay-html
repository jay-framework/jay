<html>
  <head>
    <style>
      .upload-page { max-width: 600px; margin: 40px auto; font-family: sans-serif; }
      .section { margin: 30px 0; padding: 20px; border: 1px solid #ddd; border-radius: 8px; }
      .section h2 { margin-top: 0; }
      .form-row { margin: 10px 0; }
      .form-row label { display: block; font-weight: bold; margin-bottom: 4px; }
      .form-row .hint { margin: 0 0 4px; color: #555; font-size: 0.9em; }
      .result { margin-top: 15px; padding: 10px; background: #f0f8ff; border-radius: 4px; white-space: pre-wrap; font-family: monospace; font-size: 13px; }
      button { padding: 8px 16px; cursor: pointer; }
    </style>
    <script type="application/jay-data" contract="./page.jay-contract"></script>
    <title>File Upload Demo — Fake Shop</title>
    <meta name="description" content="Single and streaming multi-file upload examples built with Jay Stack.">
  </head>
  <body>
    <main class="upload-page">
      <h1>File Upload Demo (DL#131)</h1>

      <div class="section">
        <h2>Single File Upload</h2>
        <div class="form-row">
          <label for="productName">Product Name</label>
          <p id="productName-hint" class="hint">For example: Ceramic Vase</p>
          <input ref="productName" id="productName" type="text" aria-describedby="productName-hint" />
        </div>
        <div class="form-row">
          <label for="fileInput">Product Image</label>
          <input ref="fileInput" id="fileInput" type="file" accept="image/*" />
        </div>
        <button ref="uploadBtn">Upload</button>
        <div class="result" if="uploadResult">{uploadResult}</div>
      </div>

      <div class="section">
        <h2>Streaming Multi-File Upload</h2>
        <div class="form-row">
          <label for="streamLabel">Label</label>
          <p id="streamLabel-hint" class="hint">For example: Spring Collection</p>
          <input ref="streamLabel" id="streamLabel" type="text" aria-describedby="streamLabel-hint" />
        </div>
        <div class="form-row">
          <label for="multiFileInput">Images</label>
          <input ref="multiFileInput" id="multiFileInput" type="file" accept="image/*" multiple />
        </div>
        <button ref="streamBtn">Upload &amp; Process</button>
        <div class="result" if="streamLog">{streamLog}</div>
      </div>
    </main>
  </body>
</html>

<html>
<head>
  <script type="application/jay-data" contract="./page.jay-contract"></script>
  <script type="application/jay-headless"
          plugin="product-rating"
          contract="product-rating"
          key="rating"></script>
  <title>{name} — Fake Shop</title>
  <meta name="description" content="Product details, pricing, availability, and customer ratings.">
</head>
<body>
<main>
  <div>
    product page
  </div>
  <h1>{name}</h1>
  <h2>{price}</h2>
  <h2>{sku}</h2>
    <div if="type===physical">physical</div>
    <div if="type===virtual">virtual</div>

  <button ref="add-to-cart">Add to Cart (will print in client and server consoles)</button>
    <div if="!inStock">
        out of stock, come back later
    </div>

  <!-- Product Rating Widget (Local Plugin) -->
  <div class="rating-display">
    <span class="rating-value">★ {rating.rating}</span>
    <span class="review-count">({rating.totalReviews} reviews)</span>
  </div>
  
  <div class="rate-product">
    <p>Rate this product:</p>
    <div class="stars">
      <button ref="rating.star1" class="star" aria-label="Rate 1 star"><span aria-hidden="true">★</span></button>
      <button ref="rating.star2" class="star" aria-label="Rate 2 stars"><span aria-hidden="true">★</span></button>
      <button ref="rating.star3" class="star" aria-label="Rate 3 stars"><span aria-hidden="true">★</span></button>
      <button ref="rating.star4" class="star" aria-label="Rate 4 stars"><span aria-hidden="true">★</span></button>
      <button ref="rating.star5" class="star" aria-label="Rate 5 stars"><span aria-hidden="true">★</span></button>
    </div>
    <p>Your rating: {rating.userRating} stars</p>
    <button ref="rating.submitButton">Submit Rating</button>
  </div>
  
  <div if="inStock">
    <button ref="add-to-cart">add to cart</button>
  </div>
</main>
</body>
</html>

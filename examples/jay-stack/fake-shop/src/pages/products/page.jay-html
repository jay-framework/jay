<html>
  <head>
    <script type="application/jay-data" contract="./page.jay-contract"></script>
    <title>Products — Fake Shop</title>
    <meta name="description" content="Browse all products available in the Fake Shop demo store.">
  </head>
  <body>
    <main>
      <h1>Products</h1>
      <ul>
        <li foreach="products" trackby="id">
          <a href="/products/{slug}">
            <div>{name}</div>
            <div>{price}</div>
            <div>{sku}</div>
          </a>
        </li>
      </ul>
    </main>
  </body>
</html>

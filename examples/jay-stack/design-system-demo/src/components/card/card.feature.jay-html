<html>
<head>
  <title>Feature card</title>
  <script type="application/jay-data" contract="./card.jay-contract"></script>
  <!-- A second design variant of the Card contract (DL#205). Same contract/props as card.jay-html, a
       different design: a "Most popular" ribbon above the heading. A page uses this variant by importing
       the card contract a second time with template="card.feature.jay-html" as="feature-card", then
       flattening <jay:feature-card> beside the default <jay:card>. -->
  <script type="application/jay-headless" contract="../button/button.jay-contract"></script>
  <style>
    .ds-card--feature {
      border: 1px solid #c7d2fe;
      border-radius: 10px;
      padding: 20px;
      background: #eef2ff;
    }
    .ds-card__ribbon {
      display: inline-block;
      margin: 0 0 8px;
      padding: 2px 10px;
      border-radius: 999px;
      background: #4f46e5;
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .ds-card__heading {
      font-size: 1.15rem;
      margin: 0 0 8px;
      color: #0f172a;
    }
    .ds-card__body {
      margin: 0 0 16px;
      color: #475569;
    }
  </style>
</head>
<body>
  <div class="ds-card ds-card--feature">
    <div class="ds-card__ribbon">Most popular</div>
    <h3 class="ds-card__heading">{heading}</h3>
    <p class="ds-card__body">{body}</p>
    <jay:button ref="cta" label="{ctaLabel}"><button class="ds-button">{label}</button></jay:button>
  </div>
</body>
</html>

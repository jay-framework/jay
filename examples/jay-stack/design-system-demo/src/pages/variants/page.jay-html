<html>

<head>
  <script type="application/jay-data">data:</script>
  <script type="application/jay-headless" contract="../../components/card/card.jay-contract"
    template="../../components/card/card.jay-html"></script>
  <script type="application/jay-headless" contract="../../components/card/card.jay-contract"
    template="../../components/card/card.feature.jay-html" as="feature-card"></script>
  <script type="application/jay-headless" contract="../../components/button/button.jay-contract"
    template="../../components/button/button.jay-html"></script>
  <title>Design System Demo — Variants</title>
  <meta name="description"
    content="Two design variants of one Card contract (default + feature) flattened side by side via as=.">
  <style>
    @scope (.cardDefault) to (.cta) {
      .ds-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        background: #ffffff;
      }

      .ds-card__heading {
        font-size: 1.15rem;
        margin: 0 0 8px;
        color: #0f172a;
      }

      .ds-card__body {
        margin: 0 0 16px;
        color: #475569;
      }
    }

    @scope (.cta) {
      .ds-button {
        border: 0;
        border-radius: 6px;
        padding: 8px 14px;
        background: #2563eb;
        color: #ffffff;
        cursor: pointer;
      }
    }

    @scope (.cardFeature) to (.cta) {
      .ds-card--feature {
        border: 1px solid #c7d2fe;
        border-radius: 10px;
        padding: 20px;
        background: #eef2ff;
      }

      .ds-card__ribbon {
        display: inline-block;
        margin: 0 0 8px;
        padding: 2px 10px;
        border-radius: 999px;
        background: #4f46e5;
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 600;
      }

      .ds-card__heading {
        font-size: 1.15rem;
        margin: 0 0 8px;
        color: #0f172a;
      }

      .ds-card__body {
        margin: 0 0 16px;
        color: #475569;
      }
    }
  </style>
</head>

<body>
  <div>
    <p>Variants: the same Card contract, two designs on one page — the default card and the feature
      card (aliased <code>as="feature-card"</code>), each flattened from its own template.</p>
    <jay:card ref="cardDefault" heading="Starter" body="Everything you need to get going."
      ctaLabel="Choose Starter">
      <div class="ds-card">
        <h3 class="ds-card__heading">{heading}</h3>
        <p class="ds-card__body">{body}</p>
        <jay:button ref="cta" label="{ctaLabel}"><button class="ds-button">{label}</button>
        </jay:button>
      </div>
    </jay:card><jay:feature-card ref="cardFeature" heading="Pro"
      body="For growing teams that need more." ctaLabel="Choose Pro">
      <div class="ds-card ds-card--feature">
        <div class="ds-card__ribbon">Most popular</div>
        <h3 class="ds-card__heading">{heading}</h3>
        <p class="ds-card__body">{body}</p>
        <jay:button ref="cta" label="{ctaLabel}"><button class="ds-button">{label}</button>
        </jay:button>
      </div>
    </jay:feature-card>
  </div>
</body>

</html>

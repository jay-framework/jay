<html>

<head>
  <script type="application/jay-data">data:</script>
  <script type="application/jay-headless" contract="../../components/section/section.jay-contract"
    template="../../components/section/section.jay-html"></script>
  <script type="application/jay-headless" contract="../../components/gallery/gallery.jay-contract"
    template="../../components/gallery/gallery.jay-html"></script>
  <script type="application/jay-headless" contract="../../components/card/card.jay-contract"
    template="../../components/card/card.jay-html"></script>
  <script type="application/jay-headless" contract="../../components/button/button.jay-contract"
    template="../../components/button/button.jay-html"></script>
  <title>Design System Demo — Drifted</title>
  <meta name="description"
    content="A design-system page with hand edits that were never marked override=.">
  <style>
    @scope (.hero) to (.grid) {
      .ds-section {
        padding: 24px;
        background: #f8fafc;
        border-radius: 12px;
      }

      .ds-section__title {
        font-size: 1.7rem;
        margin: 0 0 16px;
        color: #0f172a;
      }
    }

    @scope (.grid) to (.cardStarter, .cardPro) {
      .ds-gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }

      .ds-gallery__heading {
        grid-column: 1 / -1;
        margin: 0;
        font-size: 1.3rem;
        color: #1e293b;
      }
    }

    @scope (.cardStarter, .cardPro) to (.cta) {
      .ds-card {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 20px;
        background: #ffffff;
      }

      .ds-card__heading {
        font-size: 1.15rem;
        margin: 0 0 8px;
        color: #0f172a;
      }

      .ds-card__body {
        margin: 0 0 16px;
        color: #475569;
      }
    }

    @scope (.cta) {
      .ds-button {
        border: 0;
        border-radius: 6px;
        padding: 8px 14px;
        background: #2563eb;
        color: #ffffff;
        cursor: pointer;
      }
    }
  </style>
</head>

<body>
  <div>
    <p>Drifted: hand edits that were never marked override= — jay-stack validate reports them as
      drift.</p>
    <jay:section ref="hero" title="Our Plans">
      <section class="ds-section">
        <h1 class="ds-section__title">{title}</h1>
        <jay:gallery ref="grid" heading="{title}">
          <div class="ds-gallery">
            <h2 class="ds-gallery__heading">{heading}</h2>
            <jay:card ref="cardStarter" heading="Starter" body="Everything you need to get going."
              ctaLabel="Choose Starter">
              <div class="ds-card">
                <h3 class="ds-card__heading">Best Value</h3>
                <p class="ds-card__body">{body}</p>
                <jay:button ref="cta" label="{ctaLabel}"><button class="ds-button">{label}</button>
                </jay:button>
              </div>
            </jay:card>
            <jay:card ref="cardPro" heading="Pro" body="For growing teams that need more."
              ctaLabel="Choose Pro">
              <div class="ds-card">
                <h3 class="ds-card__heading">{heading}</h3>
                <p class="ds-card__body">{body}</p>
                <jay:button ref="cta" label="{ctaLabel}"><button
                    class="ds-button ds-button--xl">{label}</button></jay:button>
              </div>
            </jay:card>
          </div>
        </jay:gallery>
      </section>
    </jay:section>
  </div>
</body>

</html>

<html>
<head>
    <script type="application/jay-headfull"
            src="./card/card"
            contract="./card/card.jay-contract"
            names="card"></script>
    <script type="application/jay-data">
data:
    pageTitle: string
    cards:
        - id: string
          label: string
    </script>
</head>
<body>
<div class="page">
    <h1>{pageTitle}</h1>

    <section class="single">
        <h2>Single composite — refs.signupCard.cta</h2>
        <jay:card heading="Sign up" ref="signupCard" />
    </section>

    <section class="list">
        <h2>Repeated composite — refs.cards.cards.cta (collection)</h2>
        <ul class="cards" forEach="cards" trackBy="id">
            <li>
                <jay:card heading="{label}" ref="cards" />
            </li>
        </ul>
    </section>
</div>
</body>
</html>
